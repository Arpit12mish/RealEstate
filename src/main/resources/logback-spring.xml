<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ================================================================
         SFS Logging — logback-spring.xml
         Log dir: ./logs (local)  |  /var/log/sfs/app (prod)
         Controlled by app.logging.path in profile-specific yml.
         Profile "local"  → DEBUG + console + file appenders under ./logs
         Profile "!local" → INFO  + console + file appenders (JSON)
         ================================================================ -->

    <springProperty scope="context" name="APP_NAME"  source="spring.application.name" defaultValue="sfs"/>
    <springProperty scope="context" name="APP_ENV"   source="spring.profiles.active"  defaultValue="unknown"/>

    <!-- local → ./logs  |  prod → /var/log/sfs/app  (set via app.logging.path) -->
    <springProperty scope="context" name="LOG_DIR" source="app.logging.path" defaultValue="./logs"/>

    <!-- ============================================================
         CONSOLE APPENDER  (human-readable, always active)
         ============================================================ -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} [%X{requestId:-no-rid}] - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ============================================================
         FILE APPENDERS  (JSON via logstash-logback-encoder)
         Only activated for non-local profiles.
         ============================================================ -->

    <!-- ── sfs-api.log ─────────────────────────────────────────── -->
    <appender name="API_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/sfs-api.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archived/sfs-api.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"app":"${APP_NAME}","env":"${APP_ENV}"}</customFields>
            <includeMdcKeyName>requestId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <includeMdcKeyName>role</includeMdcKeyName>
        </encoder>
    </appender>

    <!-- ── sfs-error.log ───────────────────────────────────────── -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/sfs-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archived/sfs-error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"app":"${APP_NAME}","env":"${APP_ENV}"}</customFields>
            <includeMdcKeyName>requestId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <includeMdcKeyName>role</includeMdcKeyName>
        </encoder>
    </appender>

    <!-- ── sfs-security.log ────────────────────────────────────── -->
    <appender name="SECURITY_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/sfs-security.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archived/sfs-security.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>60</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"app":"${APP_NAME}","env":"${APP_ENV}"}</customFields>
            <includeMdcKeyName>requestId</includeMdcKeyName>
        </encoder>
    </appender>

    <!-- ── sfs-audit.log ───────────────────────────────────────── -->
    <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/sfs-audit.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archived/sfs-audit.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>180</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"app":"${APP_NAME}","env":"${APP_ENV}"}</customFields>
            <includeMdcKeyName>requestId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <includeMdcKeyName>role</includeMdcKeyName>
        </encoder>
    </appender>

    <!-- ── sfs-app.log ─────────────────────────────────────────── -->
    <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/sfs-app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archived/sfs-app.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"app":"${APP_NAME}","env":"${APP_ENV}"}</customFields>
            <includeMdcKeyName>requestId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
        </encoder>
    </appender>

    <!-- ============================================================
         PRODUCTION profile (everything except "local")
         ============================================================ -->
    <springProfile name="!local">

        <!-- API requests → sfs-api.log ONLY (additivity=false) -->
        <logger name="com.brandPitara.sfs.observability.api"
                level="INFO"
                additivity="false">
            <appender-ref ref="API_FILE"/>
        </logger>

        <!-- Security/auth events → sfs-security.log ONLY -->
        <logger name="com.brandPitara.sfs.observability.security"
                level="INFO"
                additivity="false">
            <appender-ref ref="SECURITY_FILE"/>
        </logger>

        <!-- Audit events → sfs-audit.log ONLY -->
        <logger name="com.brandPitara.sfs.observability.audit"
                level="INFO"
                additivity="false">
            <appender-ref ref="AUDIT_FILE"/>
        </logger>

        <!--
          Hibernate: silence verbose SQL/bind/entity-dump logging in production.
          Verified against hibernate-core:7.1.8.Final on the classpath:
          BasicBinder lives under type.descriptor.jdbc (not the legacy .sql
          package) and has no logger of its own - bind-parameter values are
          gated entirely by the org.hibernate.orm.jdbc.bind category
          (JdbcBindingLogging), which is TRACE-gated in Hibernate's own source,
          so OFF (not WARN) is the only setting that reliably guarantees a
          bind value - which can include PII or password hashes bound as query
          params - can never print. org.hibernate.internal.util.EntityPrinter
          is Hibernate's own internal entity-state dumper (independent of any
          entity's custom toString()) and is the confirmed source of the
          "entity dumps included passwordHash" issue this block fixes.
        -->
        <logger name="org.hibernate"                               level="WARN"/>
        <logger name="org.hibernate.SQL"                           level="WARN"/>
        <logger name="org.hibernate.orm.jdbc.bind"                 level="OFF"/>
        <logger name="org.hibernate.type.descriptor.jdbc.BasicBinder" level="OFF"/>
        <logger name="org.hibernate.type.descriptor.sql.BasicBinder"  level="OFF"/>
        <logger name="org.hibernate.internal.util.EntityPrinter"   level="OFF"/>

        <!-- Spring startup/autoconfig/security noise suppression -->
        <logger name="org.springframework"                         level="WARN"/>
        <logger name="org.springframework.web"                     level="WARN"/>
        <logger name="org.springframework.security"                level="WARN"/>
        <logger name="org.springframework.beans.factory"           level="WARN"/>
        <logger name="org.springframework.boot.autoconfigure"      level="WARN"/>
        <logger name="org.springframework.orm.jpa"                 level="WARN"/>

        <!-- Actuator health endpoint noise reduction -->
        <logger name="org.springframework.boot.actuate"           level="WARN"/>

        <!-- Hikari: allow startup/shutdown pool INFO logs, suppress DEBUG pool-stats spam -->
        <logger name="com.zaxxer.hikari"                           level="INFO"/>

        <!--
          Suppress JVM HTTP debug logging (sun.net.www.protocol.http.HttpURLConnection etc.).
          These classes log full request headers including Authorization/X-Goog-Api-Key at
          DEBUG/FINE level. Spring Boot's jul-to-slf4j bridge forwards JUL records here;
          LevelChangePropagator pushes this WARN floor back to the JUL side, preventing
          the API key from appearing in journalctl or any log file.
          GooglePlacesClient/GoogleNearbyPlaceProvider send X-Goog-Api-Key via raw
          java.net.http.HttpClient, so these guards directly protect that key.
        -->
        <logger name="sun.net.www.protocol.http"                  level="WARN"/>
        <logger name="sun.net.www.protocol.https"                 level="WARN"/>
        <logger name="sun.net"                                     level="WARN"/>
        <logger name="jdk.internal.httpclient"                    level="WARN"/>
        <logger name="jdk.internal.net.http"                      level="WARN"/>
        <logger name="jdk.event.security"                         level="WARN"/>

        <!-- Root → sfs-app.log + sfs-error.log + console -->
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="APP_FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>

    </springProfile>

    <!-- ============================================================
         LOCAL development profile
         Console always on. File appenders also active when
         SFS_LOG_DIR is set (e.g. SFS_LOG_DIR=$PWD/logs/sfs).
         ============================================================ -->
    <springProfile name="local">

        <!-- API requests → console + sfs-api.log -->
        <logger name="com.brandPitara.sfs.observability.api"
                level="INFO"
                additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="API_FILE"/>
        </logger>

        <!-- Security/auth events → console + sfs-security.log -->
        <logger name="com.brandPitara.sfs.observability.security"
                level="INFO"
                additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="SECURITY_FILE"/>
        </logger>

        <!-- Audit events → console + sfs-audit.log -->
        <logger name="com.brandPitara.sfs.observability.audit"
                level="INFO"
                additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="AUDIT_FILE"/>
        </logger>

        <!-- Suppress JVM HTTP debug logging (same as prod) — prevents key leakage in local dev -->
        <logger name="sun.net.www.protocol.http"                  level="WARN"/>
        <logger name="sun.net.www.protocol.https"                 level="WARN"/>
        <logger name="sun.net"                                     level="WARN"/>
        <logger name="jdk.internal.net.http"                      level="WARN"/>
        <logger name="jdk.event.security"                         level="WARN"/>

        <!-- Root → console + sfs-app.log + sfs-error.log -->
        <root level="DEBUG">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="APP_FILE"/>
            <appender-ref ref="ERROR_FILE"/>
        </root>

    </springProfile>

</configuration>
