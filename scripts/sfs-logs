#!/usr/bin/env bash
# =============================================================================
# sfs-logs — EC2 log search helper for Square Foot Story
#
# Install:
#   sudo cp scripts/sfs-logs /usr/local/bin/sfs-logs
#   sudo chmod +x /usr/local/bin/sfs-logs
#
# Override log directory:
#   SFS_LOG_DIR=/custom/path sfs-logs errors today
# =============================================================================

set -euo pipefail

SFS_LOG_BASE="${SFS_LOG_DIR:-/var/log/sfs}"
LOG_DIR="$SFS_LOG_BASE/app"
ARCHIVE_DIR="$SFS_LOG_BASE/archive"

API_LOG="$LOG_DIR/sfs-api.log"
ERROR_LOG="$LOG_DIR/sfs-error.log"
SECURITY_LOG="$LOG_DIR/sfs-security.log"
AUDIT_LOG="$LOG_DIR/sfs-audit.log"
APP_LOG="$LOG_DIR/sfs-app.log"

TODAY=$(date +%Y-%m-%d)

# ── Colour helpers ─────────────────────────────────────────────────────────
RED='\033[0;31m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'; CYAN='\033[0;36m'; NC='\033[0m'
info()  { echo -e "${GREEN}[sfs-logs]${NC} $*"; }
warn()  { echo -e "${YELLOW}[sfs-logs]${NC} $*"; }
error() { echo -e "${RED}[sfs-logs]${NC} $*" >&2; }

# ── File existence guard ───────────────────────────────────────────────────
require_file() {
  local file="$1"
  if [[ ! -f "$file" ]]; then
    warn "Log file not found: $file"
    warn "Check that the app is running and SFS_LOG_DIR is correct (current: $LOG_DIR)"
    exit 1
  fi
}

# ── Search: current log + today's archives ─────────────────────────────────
grep_all() {
  local pattern="$1"
  local log_file="$2"
  local archive_pattern="${ARCHIVE_DIR}/$(basename "$log_file" .log).$TODAY.*.log.gz"

  local found=0

  if [[ -f "$log_file" ]]; then
    grep -a -- "$pattern" "$log_file" && found=1 || true
  fi

  shopt -s nullglob
  for gz in $archive_pattern; do
    zgrep -a -- "$pattern" "$gz" && found=1 || true
  done
  shopt -u nullglob

  if [[ "$found" -eq 0 ]]; then
    info "No matches found for: $pattern"
  fi
}

# ── Search within a time window (current log only) ─────────────────────────
grep_between() {
  local from="$1"   # e.g. "2026-05-20 10:00"
  local to="$2"     # e.g. "2026-05-20 12:00"
  local log_file="$3"

  require_file "$log_file"

  awk -v from="$from" -v to="$to" '
    {
      line = $0
      ts = line

      sub(/^.*"@timestamp":"?/, "", ts)
      sub(/".*$/, "", ts)
      sub(/T/, " ", ts)
      sub(/\.[0-9]+.*$/, "", ts)

      if (ts >= from && ts <= to) {
        print line
      }
    }
  ' "$log_file"
}

# ── Commands ───────────────────────────────────────────────────────────────
cmd_help() {
  cat <<'EOF'
sfs-logs — Square Foot Story log search helper

Usage:
  sfs-logs api today                       All API requests today
  sfs-logs errors today                    All errors today
  sfs-logs security today                  All security/auth events today
  sfs-logs audit today                     All audit events today
  sfs-logs app today                       General app log today

  sfs-logs status 500 today                Requests with status 500 today
  sfs-logs status 401 today                Requests with status 401 today
  sfs-logs status 403 today                Requests with status 403 today

  sfs-logs request <requestId>             All log lines for one request ID
  sfs-logs api-path <path> today           All API logs matching a path fragment
  sfs-logs slow today                      Slow API events today
  sfs-logs event <event_name> today        Any event name (e.g. jwt_expired)

  sfs-logs tail api                        Live tail: API log
  sfs-logs tail errors                     Live tail: error log
  sfs-logs tail security                   Live tail: security log
  sfs-logs tail audit                      Live tail: audit log
  sfs-logs tail app                        Live tail: app log

  sfs-logs between "2026-05-20 10:00" "2026-05-20 12:00"   Time-range search (all logs)

  sfs-logs disk                            Show log directory disk usage
  sfs-logs help                            This help message

Environment:
  SFS_LOG_DIR=/custom/path sfs-logs ...   Override base directory (default: /var/log/sfs)
                                          Logs are read from $SFS_LOG_DIR/app/

EOF
}

cmd_api()      { require_file "$API_LOG";      grep_all '"event"' "$API_LOG"; }
cmd_errors()   { require_file "$ERROR_LOG";    grep_all '"event"' "$ERROR_LOG"; }
cmd_security() { require_file "$SECURITY_LOG"; grep_all '"event"' "$SECURITY_LOG"; }
cmd_audit()    { require_file "$AUDIT_LOG";    grep_all '"event"' "$AUDIT_LOG"; }
cmd_app()      { require_file "$APP_LOG";      grep_all '.' "$APP_LOG"; }

cmd_status() {
  local status="${1:-}"
  [[ -z "$status" ]] && { error "Usage: sfs-logs status <code> today"; exit 1; }
  require_file "$API_LOG"
  info "Searching for status $status in $API_LOG ..."
  grep_all "\"status\":$status" "$API_LOG"
}

cmd_request() {
  local rid="${1:-}"
  [[ -z "$rid" ]] && { error "Usage: sfs-logs request <requestId>"; exit 1; }
  info "Searching all logs for requestId: $rid"
  for f in "$API_LOG" "$ERROR_LOG" "$SECURITY_LOG" "$AUDIT_LOG" "$APP_LOG"; do
    [[ -f "$f" ]] || continue
    result=$(grep -a -- "\"$rid\"" "$f" 2>/dev/null || true)
    if [[ -n "$result" ]]; then
      echo -e "${CYAN}── $(basename "$f") ──${NC}"
      echo "$result"
    fi
  done
  # Also search archives for today
  shopt -s nullglob
  for gz in "$ARCHIVE_DIR"/*."$TODAY".*.log.gz; do
    result=$(zgrep -a -- "\"$rid\"" "$gz" 2>/dev/null || true)
    if [[ -n "$result" ]]; then
      echo -e "${CYAN}── $(basename "$gz") ──${NC}"
      echo "$result"
    fi
  done
  shopt -u nullglob
}

cmd_api_path() {
  local path_fragment="${1:-}"
  [[ -z "$path_fragment" ]] && { error "Usage: sfs-logs api-path <fragment> today"; exit 1; }
  require_file "$API_LOG"
  info "API requests matching path fragment: $path_fragment"
  grep_all "$path_fragment" "$API_LOG"
}

cmd_slow() {
  require_file "$API_LOG"
  info "Slow API events in $API_LOG ..."
  grep_all '"event":"slow_api"' "$API_LOG"
}

cmd_event() {
  local event_name="${1:-}"
  [[ -z "$event_name" ]] && { error "Usage: sfs-logs event <event_name> today"; exit 1; }
  info "Searching all logs for event: $event_name"
  for f in "$API_LOG" "$ERROR_LOG" "$SECURITY_LOG" "$AUDIT_LOG" "$APP_LOG"; do
    [[ -f "$f" ]] || continue
    result=$(grep -a -- "\"event\":\"$event_name\"" "$f" 2>/dev/null || true)
    if [[ -n "$result" ]]; then
      echo -e "${CYAN}── $(basename "$f") ──${NC}"
      echo "$result"
    fi
  done
}

cmd_tail() {
  local target="${1:-api}"
  local file
  case "$target" in
    api)      file="$API_LOG" ;;
    errors)   file="$ERROR_LOG" ;;
    security) file="$SECURITY_LOG" ;;
    audit)    file="$AUDIT_LOG" ;;
    app)      file="$APP_LOG" ;;
    *) error "Unknown target: $target. Use: api|errors|security|audit|app"; exit 1 ;;
  esac
  require_file "$file"
  info "Tailing $file (Ctrl+C to stop) ..."
  tail -f "$file"
}

cmd_between() {
  local from="${1:-}"
  local to="${2:-}"
  [[ -z "$from" || -z "$to" ]] && { error 'Usage: sfs-logs between "YYYY-MM-DD HH:MM" "YYYY-MM-DD HH:MM"'; exit 1; }
  info "Log entries between $from and $to"
  for f in "$API_LOG" "$ERROR_LOG" "$SECURITY_LOG"; do
    [[ -f "$f" ]] || continue
    echo -e "${CYAN}── $(basename "$f") ──${NC}"
    grep_between "$from" "$to" "$f"
  done
}

cmd_disk() {
  info "Log directory disk usage:"
  du -sh "$SFS_LOG_BASE" 2>/dev/null || warn "Cannot read log directory"
  echo ""
  info "Individual files:"
  ls -lh "$LOG_DIR"/*.log 2>/dev/null || warn "No log files found in $LOG_DIR"
  echo ""
  info "Archive size:"
  du -sh "$ARCHIVE_DIR" 2>/dev/null || warn "No archive directory found"
}

# ── Dispatcher ─────────────────────────────────────────────────────────────
COMMAND="${1:-help}"
shift || true

case "$COMMAND" in
  help)         cmd_help ;;
  api)          cmd_api ;;
  errors)       cmd_errors ;;
  security|auth) cmd_security ;;
  audit)        cmd_audit ;;
  app)          cmd_app ;;
  status)       cmd_status "${1:-}" ;;
  request)      cmd_request "${1:-}" ;;
  api-path)     cmd_api_path "${1:-}" ;;
  slow)         cmd_slow ;;
  event)        cmd_event "${1:-}" ;;
  tail)         cmd_tail "${1:-api}" ;;
  between)      cmd_between "${1:-}" "${2:-}" ;;
  disk)         cmd_disk ;;
  *)
    error "Unknown command: $COMMAND"
    echo ""
    cmd_help
    exit 1
    ;;
esac
