# LOCAL DEVELOPMENT ONLY. These values are intentionally unsafe for any real environment.
COMPOSE_PROJECT_NAME=sfs-local-staging
SFS_BUILD_COMMIT=working-tree
POSTGRES_DB=sfs_local_staging
POSTGRES_USER=sfs_app
POSTGRES_PASSWORD=change-me-local-only-database-password
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/sfs_local_staging
SPRING_DATASOURCE_USERNAME=sfs_app
SPRING_DATASOURCE_PASSWORD=change-me-local-only-database-password
SPRING_PROFILES_ACTIVE=local-staging

JWT_SECRET=local-only-jwt-signing-secret-change-me-0123456789
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_DAYS=15
DASHBOARD_JWT_SECRET=local-only-dashboard-jwt-secret-change-me-0123456789
DASHBOARD_JWT_ACCESS_EXPIRATION_MS=900000

SPRING_DATASOURCE_HIKARI_POOL_NAME=SfsLocalStagingHikariPool
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=2
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=5000
SPRING_DATASOURCE_HIKARI_VALIDATION_TIMEOUT=2000
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=600000
SPRING_DATASOURCE_HIKARI_MAX_LIFETIME=1800000
SPRING_JPA_QUERY_TIMEOUT_MS=10000

SERVER_TOMCAT_THREADS_MAX=50
SERVER_TOMCAT_THREADS_MIN_SPARE=5
SERVER_TOMCAT_ACCEPT_COUNT=100
SERVER_TOMCAT_MAX_CONNECTIONS=2048

APP_LOGGING_PATH=/app/logs
SFS_LOCAL_STAGING_FAKE_OTP_ENABLED=true
SFS_SEARCH_ENABLED=false
GOOGLE_MAPS_PLACES_ENABLED=false
META_INSTAGRAM_SYNC_ENABLED=false
SFS_REFRESH_TOKEN_CLEANUP_ENABLED=false

NGINX_HOST_PORT=8088
POSTGRES_DIAGNOSTIC_HOST_PORT=55432
LOCAL_STAGING_SUBNET=172.30.50.0/24
NGINX_CONTAINER_IP=172.30.50.10
JAVA_TOOL_OPTIONS=-Xms256m -Xmx512m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError
